<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoWarn>$(NoWarn);RS1036</NoWarn>
        <Description>Roslyn source generator that reads an OpenRPC document (*.openrpc.json AdditionalFiles) and emits typed DTOs, a contract interface and a JSON-RPC client class at build time. Output is deterministic and AOT-friendly.</Description>
        <PackageTags>$(PackageTags);sourcegenerator;codegen;analyzers</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The generator ships as an analyzer, and its MSBuild file makes the AdditionalFiles metadata visible to it. -->
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="build\JsonCall.Generator.props" Pack="true" PackagePath="build" />
    </ItemGroup>

</Project>
