<Project>
    <!--
      Makes per-file metadata readable by the generator:
        <AdditionalFiles Include="api.openrpc.json" Namespace="Acme.Api" ClientName="AcmeClient" />
    -->
    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Namespace" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ClientName" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="NumberType" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="JsonContext" />
    </ItemGroup>
</Project>
