<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>JSON-RPC 2.0 hosting for ASP.NET Core: AddJsonRpc and MapJsonRpc expose HTTP POST (single and batch), Server-Sent Events and WebSocket on one route, with dependency injection per call and the usual endpoint conventions (auth, CORS, rate limiting).</Description>
        <PackageTags>$(PackageTags);aspnetcore;sse;websocket</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JsonCall.Core\JsonCall.Core.csproj" />
        <ProjectReference Include="..\JsonCall.Server\JsonCall.Server.csproj" />
        <ProjectReference Include="..\JsonCall.Transport\JsonCall.Transport.csproj" />
    </ItemGroup>

</Project>
