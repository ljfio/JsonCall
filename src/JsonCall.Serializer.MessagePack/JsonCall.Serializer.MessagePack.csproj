<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>MessagePack message serializer for JsonCall, a compact binary wire format for JSON-RPC 2.0.</Description>
        <PackageTags>$(PackageTags);messagepack;serializer</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JsonCall.Core\JsonCall.Core.csproj" />
    </ItemGroup>

</Project>
