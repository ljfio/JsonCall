<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>jsoncall</AssemblyName>
        <RootNamespace>JsonCall.Tool</RootNamespace>
        <!-- The assembly is named after the command; the package keeps the JsonCall. prefix. -->
        <PackageId>JsonCall.Tool</PackageId>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>jsoncall</ToolCommandName>
        <Description>The jsoncall dotnet tool: generates a typed JSON-RPC client from an OpenRPC document or a live rpc.discover endpoint, using the same generator as JsonCall.Generator.</Description>
        <PackageTags>$(PackageTags);dotnet-tool;codegen;cli</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- The tool and the source generator share one implementation, so their output is identical. -->
        <Compile Include="..\JsonCall.Generator\Core\*.cs" LinkBase="Core" />
    </ItemGroup>

</Project>
