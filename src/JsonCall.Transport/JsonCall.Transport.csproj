<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Interchangeable JSON-RPC 2.0 transports for JsonCall: WebSocket, TCP, stdio (Content-Length framing) and HTTP with Server-Sent Events streaming.</Description>
        <PackageTags>$(PackageTags);transport;websocket;tcp;stdio;sse</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\JsonCall.Core\JsonCall.Core.csproj" />
    </ItemGroup>

</Project>
