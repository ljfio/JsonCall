<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>CBOR message serializer for JsonCall, a compact binary wire format for JSON-RPC 2.0.</Description>
        <PackageTags>$(PackageTags);cbor;serializer</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JsonCall.Core\JsonCall.Core.csproj" />
    </ItemGroup>

</Project>
