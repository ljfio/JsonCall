<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Generates an OpenRPC 1.3.2 document (Draft 07 schemas, XML doc comments) from JSON-RPC contracts and serves it through rpc.discover.</Description>
        <PackageTags>$(PackageTags);openapi;discovery;documentation</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\JsonCall.Server\JsonCall.Server.csproj" />
    </ItemGroup>

</Project>
