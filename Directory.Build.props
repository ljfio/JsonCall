<Project>

    <!-- Metadata shared by every package. Each project sets its own Description. -->
    <PropertyGroup>
        <Authors>Luke Fisher</Authors>
        <Copyright>Copyright (c) 2023-2026 Luke Fisher</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/ljfio/JsonCall</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ljfio/JsonCall</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>jsonrpc;json-rpc;json-rpc-2.0;openrpc;rpc;jsoncall</PackageTags>
    </PropertyGroup>

    <!--
      Version comes from git tags, through MinVer. Tag a commit v0.1.0 and that commit builds as 0.1.0, and
      pushing the tag publishes it. Untagged commits after it build as 0.1.1-preview.0.N (N commits since the tag);
      before any tag they build as 0.1.0-preview.0.N. Previews go to GitHub Packages, releases to nuget.org. MinVer needs the full
      history: CI checks out with fetch-depth 0. See docs/decisions/0011-only-release-tags-publish.md.
    -->
    <PropertyGroup>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
        <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    </PropertyGroup>

    <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
        <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- Source Link, embedded symbols and reproducible builds, so consumers can step into the library. -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--
      Projects under src/ ship their XML documentation, so IntelliSense shows it. CS1591 (public member without
      documentation) stays off until the backlog in docs/product/roadmap.md is cleared; then remove the NoWarn.
    -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

</Project>
