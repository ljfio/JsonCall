<Project>

    <!-- Metadata shared by every package. Each project sets its own Description. -->
    <PropertyGroup>
        <Authors>Luke Fisher</Authors>
        <Copyright>Copyright (c) 2023 Luke Fisher</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/ljfio/JsonCall</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ljfio/JsonCall</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>jsonrpc;json-rpc;json-rpc-2.0;openrpc;rpc;jsoncall</PackageTags>
    </PropertyGroup>

    <!--
      Version. Pre-release until the milestones up to 1.0 in docs/product/roadmap.md are met: the streaming wire
      convention is still a draft and the public API is not frozen. -p:VersionSuffix=preview.2 overrides the suffix;
      delete the VersionSuffix line to cut a stable release.
    -->
    <PropertyGroup>
        <VersionPrefix>0.1.0</VersionPrefix>
        <VersionSuffix>preview.1</VersionSuffix>
    </PropertyGroup>

    <!-- Source Link, embedded symbols and reproducible builds, so consumers can step into the library. -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--
      Projects under src/ ship their XML documentation, so IntelliSense shows it. CS1591 (public member without
      documentation) stays off until the backlog in docs/product/roadmap.md is cleared; then remove the NoWarn.
    -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

</Project>
