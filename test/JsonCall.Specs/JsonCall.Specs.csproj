<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>JsonCall.Specs</RootNamespace>
        <NoWarn>$(NoWarn);CS8618;CS1591</NoWarn>
        <!-- The OpenRPC specs read summaries from the XML documentation file next to this assembly. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="Reqnroll.xUnit" Version="3.3.4" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\JsonCall.Core\JsonCall.Core.csproj" />
        <ProjectReference Include="..\..\src\JsonCall.Client\JsonCall.Client.csproj" />
        <ProjectReference Include="..\..\src\JsonCall.Server\JsonCall.Server.csproj" />
        <ProjectReference Include="..\..\src\JsonCall.OpenRpc\JsonCall.OpenRpc.csproj" />
        <ProjectReference Include="..\..\src\JsonCall.Transport\JsonCall.Transport.csproj" />
        <ProjectReference Include="..\..\src\JsonCall.AspNetCore\JsonCall.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\JsonCall.Serializer.Cbor\JsonCall.Serializer.Cbor.csproj" />
        <ProjectReference Include="..\..\src\JsonCall.Serializer.MessagePack\JsonCall.Serializer.MessagePack.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Support\echo_server.py" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Support\Data\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
      The feature files live in /specs/features and are linked in here.
      Features without step definitions yet are reported as Skipped (see reqnroll.json),
      so the skipped count is the visible backlog of unimplemented specs.
    -->
    <ItemGroup>
        <ReqnrollFeatureFiles Include="..\..\specs\features\*.feature" Link="Features\%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
